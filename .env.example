# ─── JagFlix Environment Variables ──────────────────────────────────────
# Copy this to .env.local for local development.
# For Vercel deployment, set these in your Vercel project dashboard.

# ZST Labs API Key (REQUIRED)
# Sign up at https://api.zstlab.cyou to get your API key
ZST_API_KEY=your_api_key_here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
